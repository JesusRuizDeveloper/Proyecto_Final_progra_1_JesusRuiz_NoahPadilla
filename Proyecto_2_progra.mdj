							],
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGei/PxuSAgEpk=",
									"_parent": {
										"$ref": "AAAAAAGei/PxuSAfiK4="
									},
									"name": "EnterpriseService",
									"documentation": "Constructor por defecto. Crea el repositorio de empresas.",
									"stereotype": "constructor"
								},
								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGei/PxuSAhOhY=",
									"_parent": {
										"$ref": "AAAAAAGei/PxuSAfiK4="
									},
									"name": "addEnterprise",
									"documentation": "Agrega una nueva empresa solo si no existe otra con el mismo id.\n@param enterprise empresa a agregar\n@return {@code true} si se agregó; {@code false} si el id ya existía",
									"parameters": [
										{
											"_type": "UMLParameter",
