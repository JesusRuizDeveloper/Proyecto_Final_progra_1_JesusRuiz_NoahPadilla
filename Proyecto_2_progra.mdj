								"$ref": "AAAAAAGejDY+HmBcEBs="
							},
							"name": "ClientType",
							"documentation": "Enumeración que representa los tipos de cliente que puede atender un proveedor\na través de un pedido ({@code Order}).\n<p>El uso de un {@code enum} garantiza que el atributo {@code clientType}\nde la entidad {@code Order} solo pueda tomar uno de los valores válidos\ndefinidos aquí, evitando errores por cadenas de texto arbitrarias.</p>\n@author Jesús Ruiz y Noah Padilla\n@version 1.0",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGei/Pw9R/b/7E=",
									"_parent": {
										"$ref": "AAAAAAGei/Pw9R/XdOo="
									},
									"name": "isValid",
									"documentation": "Verifica si el texto recibido corresponde a alguno de los valores\ndefinidos en esta enumeración, sin distinguir mayúsculas de minúsculas.\n@param value texto a evaluar (por ejemplo, lo digitado por el usuario)\n@return {@code true} si el texto coincide con una constante del enum;\n{@code false} en caso contrario o si {@code value} es {@code null}",
									"isStatic": true,
									"parameters": [
