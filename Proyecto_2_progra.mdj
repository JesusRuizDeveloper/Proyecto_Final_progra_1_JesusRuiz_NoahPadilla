									"documentation": "Edad del proveedor.",
									"visibility": "private",
									"type": "int"
								},
								{
									"_type": "UMLAttribute",
									"_id": "AAAAAAGei/PzRCC+E+I=",
									"_parent": {
										"$ref": "AAAAAAGei/Pwph+TKAQ="
									},
									"name": "name",
									"documentation": "Nombre del proveedor.",
									"visibility": "private",
									"type": "String"
								},
