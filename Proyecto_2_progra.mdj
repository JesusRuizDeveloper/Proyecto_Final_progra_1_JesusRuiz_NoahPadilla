							},
							"name": "RegexPattern",
							"documentation": "Enumeración que centraliza las expresiones regulares (regex) utilizadas\npara validar la información ingresada por el usuario en la capa de controlador.\n<p>Reunir los patrones en un {@code enum} evita repetir cadenas de regex a lo\nlargo del código y facilita su mantenimiento: si un patrón cambia, solo se\nmodifica en un único lugar.</p>\n@author Jesús Ruiz y Noah Padilla\n@version 1.0",
							"attributes": [
								{
									"_type": "UMLAttribute",
									"_id": "AAAAAAGei/PzRSDI1qI=",
									"_parent": {
										"$ref": "AAAAAAGei/PxFR/etQ0="
									},
									"name": "pattern",
									"documentation": "Cadena con la expresión regular asociada a la constante.",
									"visibility": "private",
									"isLeaf": true,
									"type": "String",
									"isReadOnly": true
								}
							],
