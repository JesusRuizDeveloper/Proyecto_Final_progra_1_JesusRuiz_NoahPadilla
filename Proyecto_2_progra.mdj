							"documentation": "Servicio de la entidad {@link Enterprise}. Contiene la lógica de negocio y\ncoordina el acceso al {@link EnterpriseRepository}.\n@author Jesús Ruiz y Noah Padilla\n@version 1.0",
							"attributes": [
								{
									"_type": "UMLAttribute",
